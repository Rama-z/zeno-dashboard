DATABASE_URL=postgres://USER:***@localhost:5432/DATABASE?sslmode=disable
PORT=3000
SOURCE_FILE=../sesi-hermes-discord-gemini.md

# Authentication
AUTH_ENABLED=true
APP_BASE_URL=http://localhost:8080
ALLOWED_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
ADMIN_EMAILS=admin@example.com

# Email provider: resend | smtp | file
MAIL_PROVIDER=resend
RESEND_API_KEY=***
RESEND_FROM=Zeno <verify@your-verified-domain.example>
# Optional override, normally leave empty
RESEND_ENDPOINT=

# SMTP alternative (STARTTLS, commonly port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=***
SMTP_FROM=Zeno <verify@example.com>

# Development-only alternative
MAIL_FILE_DIR=./data/mail-outbox
